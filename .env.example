# Optional: use a stable, random secret of at least 32 characters.
# If omitted, a secret is generated once in data/private/session.secret.
# AUTH_SECRET=replace-with-a-long-random-secret
# DATABASE_URL=postgresql://user:password@host:5432/database
# XOT17_DB_PATH=/absolute/path/to/accounts.sqlite3
# PORT=8000
# Enable only when serving through correctly configured HTTPS.
# XOT17_SECURE_COOKIE=1

# Private JSON mapping of machine IDs to unique device keys (32+ bytes); omit to disable.
# XOT17_DEVICE_KEYS={"RVM-UB-01":"replace-with-a-unique-random-device-key-at-least-32-bytes"}
# On the separate trusted bridge host, set HARDWARE_API_KEY to the matching device key.
# RVM_SERVER_URL=https://your-rvm-service.example
